{
  "manifest_version": 3,
  "name": "RiftStream Bag Cleaner",
  "version": "1.9.3",
  "description": "Organiza a mochila do RiftStream com as suas regras por raridade: favoritar, forjar e vender itens.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://riftstream.com.br/*",
        "https://www.riftstream.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
